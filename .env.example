NODE_ENV=development
DATABASE_URL=postgresql://auditsphere:replace-with-generated-password@127.0.0.1:5432/auditsphere
REDIS_URL=redis://127.0.0.1:6379
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=auditsphere
S3_SECRET_KEY=replace-with-generated-password
S3_BUCKET=evidence
DEV_AUTH_ENABLED=true
DEV_AUTH_TOKEN=replace-with-a-random-local-token
PORT=3000

# Production storage: Microsoft Graph. local-s3 is only a local development fixture.
STORAGE_PROVIDER=local-s3
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Email is disabled by default. Enabling Graph requires Mail.Send application consent and an authorized mailbox.
NOTIFICATION_PROVIDER=disabled
M365_MAIL_TENANT_ID=
M365_MAIL_CLIENT_ID=
M365_MAIL_CLIENT_SECRET=
M365_NOTIFICATION_SENDER=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ID=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_FOLDER_ID=
# Optional non-production-only firm-private Practice folder. Production requires the
# reviewed FirmRepository database binding and a dedicated selected-folder Graph grant.
M365_PRACTICE_DRIVE_ID=
M365_PRACTICE_FOLDER_ID=
# Optional non-production-only firm-private document artwork/credential folder.
# Production requires the reviewed FirmRepository binding and its own selected-folder Graph grant.
M365_TEMPLATE_ASSETS_DRIVE_ID=
M365_TEMPLATE_ASSETS_FOLDER_ID=
AUTH_PROVIDER=development
ENTRA_API_AUDIENCE=
ENTRA_API_SCOPE=access_as_user
WEB_ORIGIN=http://127.0.0.1:4200
HOST=127.0.0.1
DATABASE_POOL_MAX=10
ENTRA_BROWSER_CLIENT_ID=
ENTRA_BROWSER_API_SCOPE=
ENTRA_BROWSER_REDIRECT_URI=
WORKER_DATABASE_URL=
REPORT_DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_TLS_CA_FILE=
POSTGRES_PASSWORD=replace-with-generated-password
